{% if include_scripts %}
  <script src="https://cdn.jsdelivr.net/npm/fullcalendar@7.0.0/all/global.js"></script>

  <script src="https://cdn.jsdelivr.net/npm/fullcalendar@7.0.0/themes/{{ theme }}/global.js"></script>

  <link href='https://cdn.jsdelivr.net/npm/fullcalendar@7.0.0/skeleton.css' rel='stylesheet' />
  <link href='https://cdn.jsdelivr.net/npm/fullcalendar@7.0.0/themes/{{ theme }}/theme.css' rel='stylesheet' />
  {% if palette %}
    <link href='https://cdn.jsdelivr.net/npm/fullcalendar@7.0.0/themes/{{ theme }}/palettes/{{ palette }}.css' rel='stylesheet' />
  {% else %}
    <link href='https://cdn.jsdelivr.net/npm/fullcalendar@7.0.0/themes/{{ theme }}/palette.css' rel='stylesheet' />
  {% endif %}
{% endif %}

{% set uniq_id = 'calendar_' ~ uniq() %}

{% if tags|length > 0 %}
  <div id="{{ uniq_id }}_tags" class="calendar-tags">
    <button
      class="calendar-tag calendar-tag--selected"
      data-calendar-tag="ALL"
    >
      All
    </button>

    {% for tag in tags %}
      <button
        class="calendar-tag"
        style="
          --calendar-tag-background-color: {{ tag.backgroundColor }};
          --calendar-tag-border-color: {{ tag.borderColor }};
          --calendar-tag-color: {{ tag.textColor }};
        "
        data-calendar-tag="{{ tag.className }}"
      >
        {{ tag.text }}
      </button>
    {% endfor %}
  </div>

  {% for tag in tags %}
    <style>
      #{{ uniq_id }}.{{ tag.className }}--hidden .{{ tag.className }} {
        display: none;
      }
    </style>
  {% endfor %}
{% endif %}

<div id="{{ uniq_id }}"></div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const SELECTED = 'calendar-tag--selected';

    const container = document.getElementById('{{ uniq_id }}');

    const calendar = new FullCalendar.Calendar(container, {
      initialView: 'dayGridMonth',
      events: "{{ path('calendar_events_json') }}",
      headerToolbar: {
        left: 'prev,next today',
        center: 'title',
        right: 'dayGridMonth,timeGridWeek,listWeek'
      }
    });

    calendar.render();

    const allTag = document.querySelector('[data-calendar-tag="ALL"]');

    if (!allTag) {
      return;
    }

    const otherTags = document.querySelectorAll('[data-calendar-tag]:not([data-calendar-tag="ALL"])');

    function allTagClick() {
      otherTags.forEach(function(otherTag) {
        otherTag.classList.remove(SELECTED);
        container.classList.remove(otherTag.dataset.calendarTag + '--hidden');
      });

      allTag.classList.add(SELECTED);
    }

    allTag.addEventListener('click', function(e) {
      e.preventDefault();

      allTagClick();
    });

    otherTags.forEach(function(otherTag) {
      otherTag.addEventListener('click', function(e) {
        e.preventDefault();

        otherTag.classList.toggle(SELECTED);

        let isAnySelected = false;

        otherTags.forEach(function(otherTag) {
          if (otherTag.classList.contains(SELECTED)) {
            isAnySelected = true;
          }
        });

        if (isAnySelected) {
          otherTags.forEach(function(otherTag) {
            if (!otherTag.classList.contains(SELECTED)) {
              container.classList.add(otherTag.dataset.calendarTag + '--hidden');
            }
          });
        } else {
          allTagClick();
        }
      });
    });
  });
</script>
