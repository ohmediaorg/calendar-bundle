{% if include_scripts %}
  <script src="https://cdn.jsdelivr.net/npm/fullcalendar@7.0.0/all/global.js"></script>

  <script src="https://cdn.jsdelivr.net/npm/fullcalendar@7.0.0/themes/{{ theme }}/global.js"></script>

  <link href='https://cdn.jsdelivr.net/npm/fullcalendar@7.0.0/skeleton.css' rel='stylesheet' />
  <link href='https://cdn.jsdelivr.net/npm/fullcalendar@7.0.0/themes/{{ theme }}/theme.css' rel='stylesheet' />
  {% if palette %}
    <link href='https://cdn.jsdelivr.net/npm/fullcalendar@7.0.0/themes/{{ theme }}/palettes/{{ palette }}.css' rel='stylesheet' />
  {% else %}
    <link href='https://cdn.jsdelivr.net/npm/fullcalendar@7.0.0/themes/{{ theme }}/palette.css' rel='stylesheet' />
  {% endif %}
{% endif %}

{% set uniq_id = 'calendar_' ~ uniq() %}

<div id="{{ uniq_id }}"></div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const container = document.getElementById('{{ uniq_id }}');

    const calendar = new FullCalendar.Calendar(container, {
      initialView: 'dayGridMonth',
      events: "{{ path('calendar_events_json') }}",
      headerToolbar: {
        left: 'prev,next today',
        center: 'title',
        right: 'dayGridMonth,timeGridWeek,listWeek'
      }
    });

    calendar.render();
  });
</script>
